<<set $t_extra1_result_100 = "extra1 得分：30分">>
<<set $t_extra2_result_0 = "extra2 得分：0分">>
<<set $t_extra2_result_50 = "extra2 得分：20分">>
<<set $t_extra2_result_100 = "extra2 得分：40分">>
<<set $t_skip_extra = "跳过所有进阶附加题">>

/* 检查点数据 */
<<include "Points_Data">>

<</nobr>>


:: ModelSelectBlock [widget] {"position":"375,450","size":"100,100"}
<<widget "modeSelectBlock">>\
    <div id="mode-select-area">\
        <!-- 使用 listbox 让玩家选择模式 -->\
        <<listbox "$mode" autoselect>>\
            <<option `$t_welcome_mode_noMode` "noMode">>\
            <<option `$t_welcome_mode_freshman` "freshman">>\
            <<option `$t_welcome_mode_veteran` "veteran">>\
        <</listbox>>\
        <<button `$t_completed`>>\
            <<if $mode === "noMode">>\
                /* 未选择模式，重绘区域并加上警告 */\
                <<replace "#mode-select-area">>\
                    <div class="warning-msg">\
                        <<print $t_experience>>\
                    </div>\
                    <<modeSelectBlock>>\
                <</replace>>\
            <<else>>\
                /* 已选择模式，替换为对话和继续链接 */\
                <<replace "#mode-select-area">>\
                    <<playerChoiceSpeech>>\
                    <<speech "Club" $t_club>><<print $t_go_together>><</speech>>\
                    <<link `$t_continue` "Reach">><</link>>\
                <</replace>>\
            <</if>>\
        <</button>>\
    </div>\
<</widget>>\


:: PlayerChoiceSpeech [widget] {"position":"375,575","size":"100,100"}
<<widget "playerChoiceSpeech">>\
    <<set _choice to ($mode === "freshman" ? $t_welcome_mode_freshman : ($mode === "veteran" ? $t_welcome_mode_veteran : $t_welcome_mode_noMode))>>\
    <<speech "You" $t_you>><<print _choice>><</speech>>\
<</widget>>\


