<<set $t_welcome_mode_veteran = "我有一定的定向越野知识和经验，请问我可以和你一起去参加这个比赛吗？">>
<<set $t_experience = "请先选择你的定向经验！">>
<<set $t_mode_freshman = "小白">>
<<set $t_mode_veteran = "老手">>
<<set $t_mode_none = "未选择">>
<<set $t_go_together = "好啊，那我们一起出发吧！">>
<<set $t_start = "前往起点" >>

/* 地点 */
<<set $t_place = "这次比赛的地方在福建厦门的鼓浪屿。鼓浪屿融历史、人文和自然景观于一体，留存着千余幢风格各异的建筑，享有“钢琴之岛”“音乐之乡”的美誉。先后获得国家5A级旅游景区、全国重点文物保护单位等荣誉。“鼓浪屿：国际历史社区”被列入世界遗产名录。">>

/* 起点 */
<<set $t_start_intro_freshman = "这里是起点。你开始了这次比赛。每次你都需要在若干条线路中选择一条路线。不同控制点有不同的分数，总共100分。祝你好运！">>
<<set $t_start_intro_veteran = "这里是起点。你开始了这次比赛。每次你都需要在若干条线路中选择一条路线。不同控制点有不同的分数，同时不定期会有附加题出现，总共200分。祝你好运！">>

/* 比赛 */
<<set $t_route_red to "红色路线">>
<<set $t_route_blue to "蓝色路线">>
<<set $t_route_orange to "橙色路线">>
<<set $t_route_brown to "褐色路线">>
<<set $t_target = "现在的目标是去">>
<<set $t_point = "号点">>
<<set $t_finish_point = "及终点">>
<<set $t_you_choose = "你选择：">>
<<set $t_quick_end = "提前结束比赛">>

/* 结束 */
<<set $t_finish = "恭喜您结束比赛！您的总成绩为：">>
<<set $t_points = "分">>
<<set $t_board = "历史排行榜">>
<<set $t_noRecord = "暂无记录">>
<<set $t_restart = "重新开始">>
<<set $t_QRcode = "欢迎加入定向越野社qq群！">>

/* 侧边栏文本 */
<<set $t_sb_player = "玩家：">>
<<set $t_sb_mode = "模式：">>
<<set $t_sb_score = "得分：">>
<<set $t_sb_view_map = "地图">>
<<set $t_sb_cds_title = "检查点说明表：">>

/* 附加题12 */
<<set $t_bonus_12_title = "现在在11号点，面向12号点方向。请问11-12号点的路线依次经过的4个路口的走向。（20分）">>
<<set $t_bonus_12_a = "A. 左转，直行，右转，左转">>
<<set $t_bonus_12_b = "B. 右转，左转，直行，左转">>
<<set $t_bonus_12_c = "C. 直行，左转，右转，左转">>
<<set $t_bonus_12_correct = "回答正确！+20分">>
<<set $t_bonus_12_wrong = "回答错误！不加分">>
