:: RenderPoint [widget] {"position":"375,200","size":"100,100"}
<<widget "renderPoint">>\
    <<if ndef $points>>\
        <<include "Points_Data">>\
    <</if>>\
    <<if ndef $t_route_red>>\
        <<if $lang === "zh">><<include "Lang_ZH">><<else>><<include "Lang_EN">><</if>>\
    <</if>>\
    <<set _pointId to Number($args[0])>>\
    <<set _point to $points.find(function(p) { return p.id === _pointId; })>>\
    <<set _imgBlank to "img/blank/" + _pointId + ".jpg">>\
    <<set _imgRoute to "img/route/" + _pointId + ".jpg">>\
    <<= '<div style="display: flex; gap: 10px; align-items: flex-start; margin-bottom: 10px;">' +
        '<img src="' + _imgBlank + '" width="400px">' +
        '<img src="' + _imgRoute + '" width="400px">' +
        '</div>' >>\
    <<if _pointId === 20>>\
        <<print $t_target + _pointId + $t_point + $t_finish_point>>\
    <<else>>\
        <<print $t_target + _pointId + $t_point>>\
    <</if>>\
    <<print $t_you_choose>>
    /* 路线选项按钮 */\
    <<for _choice range _point.choices>>\
        <<set _label = State.getVar("$t_route_" + _choice.labelKey)>>\
        <<capture _choice _label>>\
            <<if _choice.labelKey === "red">>\
                <div class="route-btn-wrapper route-red">\
                    <<button _label _choice.target>>\
                        <<set $grade += _choice.score>>\
                    <</button>>\
                </div>\
            <<elseif _choice.labelKey === "blue">>\
                <div class="route-btn-wrapper route-blue">\
                    <<button _label _choice.target>>\
                        <<set $grade += _choice.score>>\
                    <</button>>\
                </div>\
            <<elseif _choice.labelKey === "orange">>\
                <div class="route-btn-wrapper route-orange">\
                    <<button _label _choice.target>>\
                        <<set $grade += _choice.score>>\
                    <</button>>\
                </div>\
            <<else>>\
                <div class="route-btn-wrapper route-brown">\
                    <<button _label _choice.target>>\
                        <<set $grade += _choice.score>>\
                    <</button>>\
                </div>\
            <</if>>\
        <</capture>>\
    <</for>>\
    /* 通用退出按钮（提前结束比赛） */\
    <div class="quit-btn-wrapper">\
        <<button $t_quick_end "Finish">><</button>>\
    </div>\
<</widget>>


:: ShowMap [widget] {"position":"375,325","size":"100,100"}
<<widget "showMap">>\
    <<set _dialogTitle to $t_map>>\
    <<set _dialogBody to `\
        <div id="map-viewer" style="overflow: hidden; cursor: grab; display: flex; justify-content: center; align-items: center; max-height: 70vh;">\
            <img src="img/map.jpg" alt="Map" class="zoomable-map" style="max-width: 100%; max-height: 70vh; transition: transform 0.1s ease-out; user-select: none; -webkit-user-drag: none;">\
        </div>\
    `>>\
    <<run Dialog.setup(_dialogTitle, "dialog-image-viewer")>>\
    <<run Dialog.wiki(_dialogBody)>>\
    <<run Dialog.open()>>\
    <<run setTimeout(setupMapZoom, 100)>>\
<</widget>>


