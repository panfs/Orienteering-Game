<<set $t_skip_bonus = "跳过附加题">>

/* 附加题20 */
<<set $t_bonus_20_title = "结合检查点信息，20号检查点最可能放在了哪里？（10分）">>
<<set $t_bonus_20_a = "A. 花圃的西北角外">>
<<set $t_bonus_20_b = "B. 醒目树的西北角外">>
