:: Extra {"position":"825,525","size":"100,100"}
<<if $mode === "freshman">>\
    <<goto "Finish">>\
<<else>>\
    <<if $lang === "zh">><<include "Lang_ZH">><<else>><<include "Lang_EN">><</if>>\
    /* ===== 第1题 ===== */\
    <img src="img/extra.jpg" class="extra-image">\
    <<print $t_extra_title>>\
    <div class="extra-subtitle"><<print $t_extra1_title>></div>\
    <div id="extra1_options" class="bonus-options">\
        <<button `$t_extra_0`>>\
            <<set $grade += 0>>\
            <<replace "#extra1_options">>\
                <div class="bonus-feedback"><<print $t_extra1_result_0>></div>\
                <<link `$t_bonus_continue` "Extra2">><</link>>\
            <</replace>>\
        <</button>>\
        <<button `$t_extra_50`>>\
            <<set $grade += 15>>\
            <<replace "#extra1_options">>\
                <div class="bonus-feedback"><<print $t_extra1_result_50>></div>\
                <<link `$t_bonus_continue` "Extra2">><</link>>\
            <</replace>>\
        <</button>>\
        <<button `$t_extra_100`>>\
            <<set $grade += 30>>\
            <<replace "#extra1_options">>\
                <div class="bonus-feedback"><<print $t_extra1_result_100>></div>\
                <<link `$t_bonus_continue` "Extra2">><</link>>\
            <</replace>>\
        <</button>>\
        <<button `$t_skip_extra` "Finish">><</button>>\
    </div>\
<</if>>


