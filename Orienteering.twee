<<set $t_bonus_20_wrong = "回答错误！不加分">>

/* 进阶附加题 */
<<set $t_extra_title = "进阶附加题">>
<<set $t_extra1_title = "extra1. 另一张地图，5分钟内向工作人员说出12检查点到13检查点的走法，3次尝试机会。（30分）">>
<<set $t_extra2_title = "extra2. 另一张地图，5分钟内向工作人员说出16检查点到17检查点的走法，3次尝试机会。（40分）">>
<<set $t_extra_0 = "未找出正确路线">>
