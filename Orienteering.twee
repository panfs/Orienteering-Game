:: Bonus_12 {"position":"825,275","size":"100,100"}
<<if $mode !== "veteran">>\
    <<goto "Pt13">>\
<<else>>\
    <<include "Answers">>\
    <<print $t_bonus_12_title>>\
    <div id="bonus_12_options" class="bonus-options">\
        <<button `$t_bonus_12_a`>>\
            <<set $grade += 0>>\
            <<replace "#bonus_12_options">>\
                <div class="bonus-feedback"><<print $t_bonus_12_wrong>></div>\
                <<link `$t_bonus_continue` "Pt13">><</link>>\
            <</replace>>\
        <</button>>\
        <<button `$t_bonus_12_b`>>\
            <<set $grade += 20>>\
            <<replace "#bonus_12_options">>\
                <div class="bonus-feedback"><<print $t_bonus_12_correct>></div>\
                <<link `$t_bonus_continue` "Pt13">><</link>>\
            <</replace>>\
        <</button>>\
        <<button `$t_bonus_12_c`>>\
            <<set $grade += 0>>\
            <<replace "#bonus_12_options">>\
                <div class="bonus-feedback"><<print $t_bonus_12_wrong>></div>\
                <<link `$t_bonus_continue` "Pt13">><</link>>\
            <</replace>>\
        <</button>>\
        <<button `$t_skip_bonus` "Pt13">><</button>>\
    </div>\
<</if>>


