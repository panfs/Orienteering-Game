:: Finish {"position":"950,275","size":"100,100"}
/* 如果这局游戏还没被记录过，就记录并降序排序 */\
<<if !$recorded>>\
    <<set $leaderboard.push({ name: $name, mode: $mode, grade: $grade })>>\
    <<set $leaderboard.sort((a, b) => b.grade - a.grade)>>\
    <<set $recorded to true>>\
<</if>>\

/* 显示当前得分 */\
<<print $t_finish + $grade + $t_points>>

/* 显示排行榜 */\
<<print $t_board>>\
<<if $leaderboard.length === 0>>\
    <<print $t_noRecord>>\
<<else>>\
    <<for _i, _entry range $leaderboard>>\
        <div class="leaderboard-row">\
            <b class="leaderboard-name"><<print (_i + 1) + ". " + _entry.name>></b>\
            <span class="leaderboard-score">\
                <<print _entry.grade + $t_points>>\
            </span>\
            <span class="leaderboard-mode">\
                <<if _entry.mode === "freshman">>\
                    <<print $t_mode_freshman>>\
                <<else>>\
                    <<print $t_mode_veteran>>\
                <</if>>\
            </span>\
        </div>\
    <</for>>\
<</if>>\

/* 自定义重新开始按钮 */\
<<set _btn_label = $t_restart>>\
<<button _btn_label>>\
    <<set $name = "NoName">>\
    <<set $mode to "noMode">>\
    <<set $grade to 0>>\
    <<set $recorded to false>>\
    <<goto "Welcome">>\
<</button>>\

<<speech "Club" $t_club>><<print $t_QRcode>><</speech>>\
<img src="img/QRcode.jpg" class="finish-qrcode">


:: Lang_EN {"position":"225,325","size":"100,100"}
<<nobr>>

/* Opening */
<<set $t_game_titile = "Orienteering Game">>
<<set $t_club = "SUSTech Orienteering Club">>
<<set $t_you = "You">>
<<set $t_enter_name = "Please enter your name.">>
<<set $t_completed = "Completed.">>
<<set $t_continue = "Continue">>
<<set $t_name_edited_completely_welcome = "Welcome, ">>
<<set $t_exclamation =" !">>
<<set $t_background = "Your friend H is a seasoned orienteering expert. One day, out of nowhere, they got their hands on a free entry to an orienteering competition—lodging and round-trip travel included. No sooner had H received the news than they began muttering to themselves. Just then, you happened to walk past. You did a quick mental check—you're free on the day of the competition, and it could be fun. So you step up to H and say:">>
<<set $t_welcome_mode_noMode = "Please select">>
<<set $t_welcome_mode_freshman = "I'm a total beginner at orienteering. Would it be okay if I came along with you to this competition?">>
<<set $t_welcome_mode_veteran = "I have some orienteering knowledge and experience. Would it be okay if I came along with you to this competition?">>
<<set $t_experience = "Please select your orienteering experience first!">>
<<set $t_mode_freshman = "Beginner">>
<<set $t_mode_veteran = "Veteran">>
<<set $t_mode_none = "Not selected">>
<<set $t_go_together = "Sure, let's head out together!">>

/* Place */
<<set $t_place = "The venue for this competition is Gulangyu Island in Xiamen, Fujian. Blending history, humanity and natural landscapes, Gulangyu is home to over a thousand buildings of diverse architectural styles. It is known as the \"Island of Pianos\" and \"Hometown of Music\". It has been awarded honors including National 5A-level Tourist Attraction and Major Historical and Cultural Site Protected at the National Level. \"Kulangsu: A Historic International Settlement\" is inscribed on the World Heritage List.">>

/* Start */
<<set $t_start = "Go to start place" >>
<<set $t_start_intro_freshman = "Here is the starting point. Your competition begins. Each round you must pick one route from several options. Different control points grant different points, with a total of 100 points available. Good luck!">>
<<set $t_start_intro_veteran = "Here is the starting point. Your competition begins. Each round you must pick one route from several options. Different control points grant different points. Bonus challenges will appear on an irregular basis, for a total of 200 points available. Good luck!">>
    
/* Competition */
<<set $t_route_red to "Red Route">>
<<set $t_route_blue to "Blue Route">>
<<set $t_route_orange to "Orange Route">>
<<set $t_route_brown to "Brown Route">>
<<set $t_you_choose to "You choose:">>
<<set $t_target = "Your target is Control Point ">>
<<set $t_point = "">>
<<set $t_finish_point = " and Finish Point">>
<<set $t_quick_end = "End the race early">>
  
/* Finish */
<<set $t_finish = "Congratulations on completing the competition! Your total score: ">>
<<set $t_points = "Points">>
<<set $t_board = "Leaderboard">>
<<set $t_noRecord = "No Records for Now">>
<<set $t_restart = "Restart">>
<<set $t_QRcode = "Welcome to join the Orienteering Club QQ Group!">>

/* SideBar */
<<set $t_sb_player = "Player:">>
<<set $t_sb_mode = "Mode:">>
<<set $t_sb_score = "Score:">>
<<set $t_sb_view_map = "View Full Map">>
<<set $t_sb_cds_title = "Control Description Sheet:">>

/* Bonus 12 */
<<set $t_bonus_12_title = "You are now at Control Point 11, facing Control Point 12. What is the sequence of turns at the 4 intersections along the route from Control Point 11 to Control Point 12? (20 points)">>
<<set $t_bonus_12_a = "A. Left, Straight, Right, Left">>
<<set $t_bonus_12_b = "B. Right, Left, Straight, Left">>
<<set $t_bonus_12_c = "C. Straight, Left, Right, Left">>
<<set $t_bonus_12_correct = "Correct! +20 points">>
<<set $t_bonus_12_wrong = "Incorrect! No points">>
<<set $t_bonus_continue = "Continue">>
<<set $t_skip_bonus = "Skip the bouns question">>

/* Bonus 20 */
<<set $t_bonus_20_title = "Based on the clue, where is Control Point 20 most likely located? (10 points)">>
<<set $t_bonus_20_a = "A. Outside the northwest corner of the flowerbed">>
<<set $t_bonus_20_b = "B. Outside the northwest corner of the prominent tree">>
<<set $t_bonus_20_c = "C. Outside the southeast corner of the flowerbed">>
<<set $t_bonus_20_d = "D. Outside the southeast corner of the prominent tree">>
<<set $t_bonus_20_correct = "Correct! +10 points">>
<<set $t_bonus_20_wrong = "Incorrect! No points">>

/* Extra */

<<set $t_extra_title = "Advanced Bonus Challenges">>
<<set $t_extra1_title = "On this map, describe to the staff within 3 minutes the route from Control Point 12 to Control Point 13. You have 3 options. (30 points)">>
<<set $t_extra2_title = "extra2. On another map, describe to the staff within 3 minutes the route from Control Point 16 to Control Point 17. You have 3 options. (40 points)">>
<<set $t_extra_0 = "Correct route not found">>
<<set $t_extra_50 = "Correct route found in over 3 minutes">>
<<set $t_extra_100 = "Correct route found within 3 minutes">>
<<set $t_extra1_result_0 = "extra1 score: 0 points">>
<<set $t_extra1_result_50 = "extra1 score: 15 points">>
<<set $t_extra1_result_100 = "extra1 score: 30 points">>
<<set $t_extra2_result_0 = "extra2 score: 0 points">>
<<set $t_extra2_result_50 = "extra2 score: 20 points">>
<<set $t_extra2_result_100 = "extra2 score: 40 points">>
<<set $t_skip_extra = "Skip all advanced bonuses">>


/* Points Data */
<<include "Points_Data">>
<</nobr>>


:: Lang_ZH {"position":"225,200","size":"100,100"}
<<nobr>>

/* 开场 */
<<set $t_game_titile = "定向越野游戏">>
<<set $t_club = "南科大定向队">>
